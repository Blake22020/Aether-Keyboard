{
  "id": "builtin.neon",
  "name": "Неон",
  "version": "2.0",
  "author": "Expressive Keyboard",
  "description": "Почти чёрный фон, тонкие бирюзовые контуры с мягким свечением, розовые служебные клавиши. При нажатии клавиша загорается.",
  "icon": "🌃",
  "skin": {
    "keyboard": {
      "background": "#0B0A12",
      "orbs": [
        { "color": "#2E7A2BFF", "x": 0.5, "y": 1.15, "r": 0.7 },
        { "color": "#1A00E5FF", "x": 0.05, "y": 0.0, "r": 0.4 }
      ],
      "trail": "#00E5FF",
      "corner": 24
    },
    "colors": {
      "background": "#0B0A12", "key": "#14131F", "keyText": "#E9FDFF",
      "func": "#14131F", "funcText": "#FFE8F8", "accent": "#FF3DC8", "accentText": "#FFFFFF"
    },
    "keys": {
      "*": {
        "material": "outline",
        "background": "#0AFFFFFF",
        "border": "#8C00E5FF",
        "borderWidth": 1.2,
        "glow": "#2E00E5FF",
        "text": "#E9FDFF",
        "textGlow": "#9900E5FF",
        "pressedBackground": "#00E5FF",
        "pressedText": "#0B0A12",
        "press": "bounce",
        "pressScale": 1.05,
        "radius": 10,
        "inset": 1
      },
      "func": { "border": "#8CFF3DC8", "glow": "#2EFF3DC8", "text": "#FFE8F8", "textGlow": "#99FF3DC8", "pressedBackground": "#FF3DC8" },
      "enter": {
        "material": "solid",
        "background": { "colors": ["#FF3DC8", "#8A3DFF"], "angle": 0 },
        "text": "#FFFFFF", "textGlow": "#00FFFFFF", "glow": "#80FF3DC8"
      }
    },
    "popup": { "radius": 12, "background": "#1A1830", "border": "#00E5FF", "text": "#E9FDFF", "pressedBackground": "#00E5FF", "pressedText": "#0B0A12" },
    "chips": { "material": "none", "text": "#BFF8FF" },
    "buttons": { "material": "outline", "border": "#8C00E5FF", "borderWidth": 1.2, "glow": "#3300E5FF", "text": "#9CF5FF", "pressedBackground": "#00E5FF" }
  }
}
