{
  "id": "builtin.neumorph",
  "name": "Неоморфизм",
  "version": "3.0",
  "author": "Expressive Keyboard",
  "description": "Мягкие выпуклые клавиши из того же материала, что и фон: свет сверху слева, тень снизу справа, при нажатии клавиша вдавливается. Светлый и тёмный вариант.",
  "icon": "☁️",
  "skin": {
    "keyboard": { "corner": 28 },
    "colors": {
      "background": "#E6EAF1", "key": "#E6EAF1", "keyText": "#39404F",
      "func": "#E6EAF1", "funcText": "#68718A", "accent": "#6B7FF0", "accentText": "#FFFFFF"
    },
    "keys": {
      "*": {
        "material": "neumorph",
        "background": { "colors": ["#EEF1F7", "#DFE4EC"], "angle": 135 },
        "pressedBackground": { "colors": ["#D9DEE7", "#E9EDF3"], "angle": 135 },
        "shadow": 8,
        "shadowY": 4,
        "shadowColor": "#73A6B3C9",
        "press": "sink",
        "radius": 16,
        "pressedRadius": 16,
        "inset": 3.5,
        "hideHint": true
      },
      "shift": { "text": "#6B7FF0" },
      "enter": {
        "background": { "colors": ["#8396FF", "#5F73EA"], "angle": 135 },
        "pressedBackground": "#5367DD",
        "text": "#FFFFFF",
        "shadowColor": "#596B7FF0"
      }
    },
    "popup": { "radius": 16, "background": "#F1F3F8", "text": "#39404F", "pressedBackground": "#6B7FF0", "pressedText": "#FFFFFF" },
    "chips": { "material": "none", "text": "#39404F" },
    "buttons": {
      "material": "neumorph",
      "background": { "colors": ["#EEF1F7", "#DFE4EC"], "angle": 135 },
      "shadow": 6, "shadowY": 3, "shadowColor": "#73A6B3C9", "text": "#68718A"
    },
    "panel": {
      "material": "neumorph",
      "background": "#E6EAF1",
      "shadow": 10, "shadowY": 5, "shadowColor": "#66A6B3C9",
      "radius": 24, "inset": 4
    },
    "dark": {
      "colors": {
        "background": "#262A32", "key": "#262A32", "keyText": "#DDE2EC",
        "func": "#262A32", "funcText": "#A0A8BA", "accent": "#7C8EFF", "accentText": "#FFFFFF"
      },
      "keys": {
        "*": {
          "background": { "colors": ["#2C3039", "#22262D"], "angle": 135 },
          "pressedBackground": { "colors": ["#1F2329", "#2A2E36"], "angle": 135 },
          "shadowColor": "#E6131519"
        },
        "shift": { "text": "#7C8EFF" },
        "enter": { "background": { "colors": ["#8B9BFF", "#6576F0"], "angle": 135 }, "shadowColor": "#661C1F26" }
      },
      "popup": { "background": "#30353F", "text": "#E6E9F0", "pressedBackground": "#7C8EFF" },
      "chips": { "text": "#DDE2EC" },
      "buttons": { "background": { "colors": ["#2C3039", "#22262D"], "angle": 135 }, "shadowColor": "#E6131519", "text": "#A0A8BA" },
      "panel": { "background": "#262A32", "shadowColor": "#CC131519" }
    }
  }
}
